<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=gb2312" />
    <title>图文F10</title>
    <link rel="stylesheet" type="text/css" href="css/main.css">

    <script src="../lib/jquery.min.js" type="text/javascript"></script>
    <script src="../lib/connect/req.js" type="text/javascript"></script>
<style type="text/css">
	a{
		color:#212121
	}
	</style>
   <script>var globConfig={
	"gg_ggzl":"高管治理",
	"nametext":"代码",
            "sctext":"市场",
	"initText":"输入代码、拼音或简称",
	"zsTxt":"指数",
	"noDataText":"未找到匹配项"
	}</script>
    <script src="js/f10_main_static.js" type="text/javascript"></script>

<script src="js/f10_main_input.js" type="text/javascript"></script>
</head>
<body>
<div class="leftbox" style="display:none">
    <div class="gginfo">
        <div id="market" style="display:none">@@@CURRGPMARK@@@</div>
        <div id="code" style="display:none">@@@CURRGPCODE@@@</div>
        <div id="name" style="display:none">@@@CURRGPNAME@@@</div>
        <div id="vertype" style="display:none">@@@CURRTDXVER@@@</div>
        <div id="gpname" class="showname">
            <div class="gpclr">
                <span class="nmclr"></span>
                <span class="cdclr"></span>
            </div>
            <div id="close" class="close" style="display: none;">×</div></div>
        <div id="btn" class="othergp" style="display: none;">
            <div class="tdxup"><a href="http://f11treeid/tdxtxtup">上一只</a></div>
            <div class="tdxdown"><a href="http://f11treeid/tdxtxtdown">下一只</a></div>
        </div>
    </div>
    <div id="container" class="container">
        <a  class="selfunc" value="gg_zxts" href="javascript:void(0)">最新提示</a>
        <a  value="gg_jyds" href="javascript:void(0)">资金动向</a>
        <a  value="gg_gsgk" href="javascript:void(0)">公司资料</a>
        <div class="sepe"></div>
        <a  value="gg_gbjg" href="javascript:void(0)">股本结构</a>
        <a  value="gg_gdyj" href="javascript:void(0)">股东研究</a>

        <a  value="gg_fhrz" href="javascript:void(0)">分红融资</a>
        <div class="sepe"></div>
        <a  value="gg_cwfx" href="javascript:void(0)">财务分析</a>
	<a  value="gg_cwzd" href="javascript:void(0)">财务诊断</a>

        <a  value="gg_jyfx" href="javascript:void(0)">经营分析</a>
        <a  value="gg_zbyz" href="javascript:void(0)">资本运作</a>
        <div class="sepe"></div>
        <a  value="gg_ybpj" href="javascript:void(0)">研报评级</a>
        <a  value="gg_rdtc" href="javascript:void(0)">热点题材</a>
        <a  value="gg_gszx" href="javascript:void(0)">公司资讯</a>        
	<div class="sepe"></div>
	<a  value="gg_zlcc" href="javascript:void(0)">主力持仓</a>
        <a  value="gg_hyfx" href="javascript:void(0)">行业分析</a>
        <a  value="gg_sdfx" href="javascript:void(0)">深度分析</a>
	<a  value="gg_ggzp" href="javascript:void(0)">个股综评</a>

	<div class="sepe"></div>
    </div>
    <div class="gginfo basef10contaner" style="border-bottom-width:0px;text-align:center;height:32px;line-height:32px"><a
                href="http://www.treeid/F10" style="line-height:32px;padding-right:6px;cursor: pointer;"
                class="showname">基础F10</a>
            </div>
        <div class="svgcontainer scancontainer" id="svgcontainer" style="display: none;"><span  class="imgbox max"></span><span id="blbox" class="blbox">100</span><span class="imgbox min"></span></div>
        <div class="svgcontainer zxgcontainer" id="zxgcontainer" style="display: none;"><span id="svgevent" class="svgevent"><span  class="svgbox zxgsvg"></span><span  class="zxgtext">自选</span></span></div>
</div>

<div class="contentbox"><div style="display:none" class="loading" id="loading">正在加载中...</div>
      <iframe
        id="tdxf10"
        curiframebox="0"
        frameborder="0"
        width="100%"
        height="100%"
        style=""
      ></iframe>
      <iframe
        id="tdxf10click"
        curiframebox="0"
        frameborder="0"
        width="100%"
        height="100%"
        style="display:none"
      ></iframe></div>
</body>
</html>
